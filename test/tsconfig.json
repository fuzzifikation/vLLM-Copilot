{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    // Do not load the ambient @types/vscode here — test files resolve `vscode`
    // to the unit-test mock via paths, and the ambient module would merge with
    // or shadow that resolution.
    "types": ["node"],
    // Test files resolve `vscode` to the unit-test mock (test/__mocks__/vscode.ts),
    // the surface the tests were written against; vitest performs the same alias
    // at runtime. Editor-only: `tsc` (both -p and -b) does not honor `paths` for
    // ambient module names like `vscode`, so this is NOT a build gate. Src modules
    // imported by tests are compiled in this project too — a relaxed view that
    // only affects editor typing, never the shipped extension (root tsconfig
    // type-checks src against real VS Code in the build).
    "paths": {
      "vscode": ["./__mocks__/vscode.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "out", "../out"]
}

