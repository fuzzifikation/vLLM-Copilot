{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    // Do not load the ambient @types/vscode here — test files resolve `vscode`
    // to the unit-test mock via paths, and the ambient module would merge with
    // or shadow that resolution.
    "types": ["node"],
    // Test files resolve `vscode` to the unit-test mock (test/__mocks__/vscode.ts),
    // the surface the tests were written against; vitest performs the same alias
    // at runtime. tsc DOES honor this `paths` mapping for the ambient `vscode`
    // name, so `npm run test:typecheck` (in the build chain) IS a real gate:
    // src modules imported by tests are type-checked against the mock here.
    // Anything src/ uses as a VALUE (e.g. vscode.Disposable.from) must exist
    // at runtime in the mock, not just as an interface. The root tsconfig
    // still type-checks src against real @types/vscode in `npm run compile`.
    "paths": {
      "vscode": ["./__mocks__/vscode.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "out", "../out"]
}

