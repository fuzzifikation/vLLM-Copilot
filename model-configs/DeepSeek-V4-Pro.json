// DeepSeek V4 Pro — Model configuration (official 0813 GA release)
// Model card: https://huggingface.co/deepseek-ai/DeepSeek-V4-Pro-0813
// vLLM recipe: https://recipes.vllm.ai/deepseek-ai/DeepSeek-V4-Pro (updated 2026-08-26)
// Verified 2026-11-10, including current vLLM Python/native reasoning controls.
//
// Flagship of the V4 family: 1.6T total / 49B active MoE, hybrid CSA+HCA
// attention, 1,048,576-token native context. Text-only. FP4+FP8 mixed
// checkpoint (~960 GB); NVFP4 variant: nvidia/DeepSeek-V4-Pro-NVFP4.
// The "DeepSeek-V4-Pro" id below substring-matches the 0813 GA release, the
// preview, and the NVFP4/DSpark variants.
//
// Reasoning modes (recipe: keep reasoning controls in chat_template_kwargs):
//   - max:    chat_template_kwargs {thinking: true, reasoning_effort: "max"}
//     Needs a server context window >= 393,216 (384K) — on smaller servers
//     max-effort thinking runs can be truncated.
//   - high:   chat_template_kwargs {thinking: true, reasoning_effort: "high"}
//   - none:   reasoning_effort "none" + chat_template_kwargs {thinking: false}
//     Omitting these controls is not off: current vLLM defaults to thinking.
//   - A "low" effort level also exists on 0813; not exposed as a mode here
//     (high already balances depth/latency — add it if users ask).
//
// Sampling (card, local deployment): temperature = 1.0; top_p = 0.95 for
// agentic scenarios, top_p = 1.0 otherwise. Benchmark recipe: temp=1.0,
// top_p=0.95, max effort. Card recommends up to 384K output at high/max —
// do NOT reserve that much: input = context − output; even the 131K ladder
// default leaves ~917K input at 1M context.
//
// To apply manually, merge "config" into an existing model entry.
// Keep that entry's id, server and actual server model ID unchanged.
//
// Token budgets:
//   - Context window: 1,048,576 tokens; the maxOutputTokens ladder below
//     (default 131,072) leaves ~917K input at full 1M server context. On
//     smaller serve windows pick a shorter Output Length to keep input room.


{
  "presetVersion": 1,
  "match": ["DeepSeek-V4-Pro"],
  "meta": {
    "source": "https://huggingface.co/deepseek-ai/DeepSeek-V4-Pro-0813",
    "verified": "2026-11-10",
    "notes": "V4 flagship (1.6T MoE, 1M context, text-only). Thinking via chat_template_kwargs {thinking, reasoning_effort}; card sampling temp=1.0, top_p=0.95."
  },
  "config": {
    "displayName": "DeepSeek V4 Pro",
    "family": "deepseek_v4",
    "maxOutputTokens": [131072, 65536, 32768, 16384],
    "capabilities": {
      "toolCalling": true,
      "imageInput": false
    },
    "defaultParams": {
      "temperature": 1.0
    },
    "modelModes": {
      "max": {
        "chat_template_kwargs": {
          "thinking": true,
          "reasoning_effort": "max"
        },
        "top_p": 0.95
      },
      "high": {
        "chat_template_kwargs": {
          "thinking": true,
          "reasoning_effort": "high"
        },
        "top_p": 0.95
      },
      "none": {
        "reasoning_effort": "none",
        "chat_template_kwargs": {
          "thinking": false
        },
        "top_p": 1.0
      }
    },
    "defaultMode": "max"
  }
}
