// Qwen3.8-Flash-Next — Model configuration
// Source: https://huggingface.co/Qwen/Qwen3.8-Flash-Next-FP8 (released 2026-08-26)
// Verified 2026-08-27 against the model card, chat_template.jinja and generation_config.json.
//
// NEW ARCHITECTURE: model_type "qwen4_exp" (NOT qwen3_5). 125B total / 6B active MoE
// + 51B n-gram PLE embedding table + 4B MTP head. Multimodal (vision).
//
// NOTE: These params work for ANY quantization variant (FP8, NVFP4, GGUF, etc.).
// Preset matching is substring-based, so this preset applies to any served id
// containing "Qwen3.8-Flash-Next". The config's `vllmModelId` must still be an
// EXACT served model id — the extension never strips or forgives mismatches.
//
// Chat template parameters (Jinja template variables, passed via chat_template_kwargs):
//   - `enable_thinking: true/false` — default true; false emits no thinking tokens
//     (template appends an empty  block). No-Think IS supported.
//   - `preserve_thinking: true` — keeps  thinking... blocks in multi-turn history.
//     Default true for this family; set false to strip historical thinking.
//
// Reasoning depth (top-level request param, NOT a chat_template_kwarg):
//   - `reasoning_effort`: xhigh (default) | medium | low. Any other value raises a
//     template exception. Only applies when thinking is enabled.
//
// Sampling (official card recipes; generation_config.json ships the thinking set):
//   - Thinking:    temp=1.0, top_p=0.95, top_k=20, min_p=0.0, presence=0.0, rep=1.0
//   - No-think:    temp=0.7, top_p=0.80, top_k=20, min_p=0.0, presence=1.5, rep=1.0
//   - Qwen's own agentic benchmarks (DeepSWE, SWE-bench Pro/Multilingual) ran with
//     temp=1.0, top_p=0.95 at a 256K context window. There is NO temp=0.6 coding
//     variant for this model (that was Qwen3.6 only).
//
// Token budgets (native 262,144 context):
//   - The card advertises up to 262K thinking / 131K final tokens, but reserving
//     that much output would halve usable input (input = context − output).
//     The maxOutputTokens ladder defaults to 32,768 — ~229K input survives, the
//     operating point Qwen itself benched at. Truncated thinking turns are rare
//     and recoverable; 16,384 serves direct answers and 8,192 quick exchanges.
//
// Longer context via YaRN is a server-side option — deliberately NOT assumed
//   here: static YaRN keeps the scaling factor constant regardless of input
//   length, which the card warns "potentially impacts performance on shorter
//   texts". Qwen ran all agentic benchmarks at native 256K without YaRN, so
//   this preset budgets for native context only.
//
// To use manually, copy the "config" object below into settings.json:
//   "vllm-copilot.models": [ <PASTE_HERE> ]


{
  "presetVersion": 1,
  "match": ["Qwen3.8-Flash-Next"],
  "meta": {
    "name": "Qwen3.8-Flash-Next",
    "source": "https://huggingface.co/Qwen/Qwen3.8-Flash-Next-FP8",
    "verified": "2026-08-27",
    "notes": "qwen4_exp MoE (125B/6B active) with vision, 262K context. reasoning_effort xhigh/medium/low; official card sampling for thinking and no-think."
  },
  "config": {
    "vllmModelId": "Qwen3.8-Flash-Next",
    "displayName": "Qwen3.8-Flash-Next",
    "family": "qwen4_exp",
    "maxOutputTokens": [32768, 16384, 8192],
    "capabilities": {
      "toolCalling": true,
      "imageInput": true
    },
    "modelModes": {
      "Think (Deep)": {
        "chat_template_kwargs": {
          "enable_thinking": true,
          "preserve_thinking": true
        },
        "reasoning_effort": "xhigh",
        "temperature": 1.0,
        "top_p": 0.95,
        "top_k": 20,
        "min_p": 0.0,
        "presence_penalty": 0.0,
        "repetition_penalty": 1.0
      },
      "Think (Balanced)": {
        "chat_template_kwargs": {
          "enable_thinking": true,
          "preserve_thinking": true
        },
        "reasoning_effort": "medium",
        "temperature": 1.0,
        "top_p": 0.95,
        "top_k": 20,
        "min_p": 0.0,
        "presence_penalty": 0.0,
        "repetition_penalty": 1.0
      },
      "No Think": {
        "chat_template_kwargs": {
          "enable_thinking": false
        },
        "temperature": 0.7,
        "top_p": 0.8,
        "top_k": 20,
        "min_p": 0.0,
        "presence_penalty": 1.5,
        "repetition_penalty": 1.0
      }
    },
    "defaultMode": "Think (Deep)"
  }
}
