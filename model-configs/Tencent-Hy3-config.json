// Hy3 — Model configuration
// Source: Tencent Hy3 model card
// https://huggingface.co/tencent/Hy3
// Verified 2026-07-18.
//
// NOTE: These params work for ANY quantization variant (FP8, GGUF, AWQ, etc.).
// Preset matching is substring-based, so a preset for the base model applies to
// any served variant whose id contains it. The user model entry keeps
// its exact server model id; the preset does not rename it.
//
// Chat template parameters (all Jinja template variables, passed via chat_template_kwargs):
//   - `reasoning_effort: "no_think" / "low" / "high"` — controls chain-of-thought depth
//     "no_think" (default) = direct response; "high" = deep reasoning
//
// To apply manually, merge "config" into an existing model entry.
// Keep that entry's id, server and actual server model ID unchanged.
//
// Token budgets:
//   - Context window: 262,144 tokens (256K official, vLLM rounds up)
//   - maxOutputTokens ladder [32768, 16384, 8192] — default 32,768 (safe for
//     most queries), 8,192 for quick answers
//   - maxInputTokens: auto-computed as ~229,376 (context window minus output)
//   - For complex tasks needing larger output, increase maxOutputTokens in settings
//
// Modes (values from official Hy3 model card / quickstart):
//   - high:   Deep chain-of-thought (reasoning_effort="high", temp=0.9)
//   - low:  Light reasoning (reasoning_effort="low", temp=0.9)
//   - none:       Direct responses, no thinking tokens (temp=0.9)
//


{
  "presetVersion": 1,
  "match": ["Hy3"],
  "meta": {
    "source": "https://huggingface.co/tencent/Hy3",
    "verified": "2026-07-18",
    "notes": "Tencent Hy3. Chain-of-thought depth via chat_template_kwargs.reasoning_effort (high/low/no_think). Sampling temp=0.9, top_p=1.0."
  },
  "config": {
    "displayName": "Hy3",
    "family": "hy_v3",
    "maxOutputTokens": [32768, 16384, 8192],
    "capabilities": {
      "toolCalling": true,
      "imageInput": false
    },
    "defaultParams": {
      "temperature": 0.9,
      "top_p": 1.0
    },
    "modelModes": {
      "high": {
        "chat_template_kwargs": {
          "reasoning_effort": "high"
        }
      },
      "low": {
        "chat_template_kwargs": {
          "reasoning_effort": "low"
        }
      },
      "none": {
        "chat_template_kwargs": {
          "reasoning_effort": "no_think"
        }
      }
    },
    "defaultMode": "high"
  }
}