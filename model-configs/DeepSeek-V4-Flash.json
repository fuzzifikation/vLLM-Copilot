// DeepSeek V4 Flash — Model configuration
// Current API model version: DeepSeek-V4-Flash-0731
//   https://api-docs.deepseek.com/quick_start/pricing/#model-details
//
// Model card: https://huggingface.co/deepseek-ai/DeepSeek-V4-Flash-0731
// Pricing:   https://api-docs.deepseek.com/quick_start/pricing
//
// Model card sampling recommendations (local deployment):
//   "temperature = 1.0, top_p = 0.95 for agentic scenarios,
//    top_p = 1.0 otherwise"
// Evaluation uses temperature=1.0, top_p=0.95 with max reasoning effort.
//
// To apply manually, merge "config" into an existing model entry.
// Keep that entry's id, server and actual server model ID unchanged.
//
// Token budgets:
//   - Context window: 1,048,576 tokens (model supports up to 1M)
//   - maxOutputTokens ladder [131072, 65536, 32768, 16384] (default 131,072).
//     The model supports up to 384K output; even 131K leaves ~917K input at
//     full 1M server context. On smaller serve windows pick a shorter length
//     in the Output Length dropdown — output + input must fit max_model_len.
//   - maxInputTokens: auto-computed from server max_model_len
//
// Thinking mode — vLLM behavior:
//   vLLM auto-injects chat_template_kwargs.enable_thinking from reasoning_effort:
//     "high"/"max" → enable_thinking=true   (DeepSeekV3ReasoningWithThinkingParser)
//     "none"        → enable_thinking=false  (IdentityReasoningParser, no thinking tokens)
//   ref: https://docs.vllm.ai/en/stable/features/reasoning_outputs (auto-inject section)
//   No separate "thinking" parameter is needed — reasoning_effort alone suffices.
//
// DeepSeek API (cloud) reference: https://api-docs.deepseek.com/guides/thinking_mode
//   temperature/top_p are silently ignored in thinking mode on their API.
//   This does NOT apply to local vLLM — those params DO take effect there.
//
// Model card sampling recommendations: https://huggingface.co/deepseek-ai/DeepSeek-V4-Flash-0731
//   "temperature = 1.0, top_p = 0.95 for agentic scenarios, top_p = 1.0 otherwise"
//   Evaluation uses temperature=1.0, top_p=0.95 with max reasoning effort.
//   These are authoritative for local vLLM and applied in all modes.
//
// Modes:
//   - max:    Maximum reasoning effort
//   - high:   Standard deep reasoning (default)
//   - none:       Direct responses, no thinking tokens (IdentityReasoningParser)

{
  "presetVersion": 1,
  "match": ["DeepSeek-V4-Flash"],
  "meta": {
    "source": "https://huggingface.co/deepseek-ai/DeepSeek-V4-Flash-0731",
    "verified": "2026-11-10",
    "notes": "1M-context MoE. Thinking depth via top-level reasoning_effort (max/high/none, auto-injected by vLLM); card sampling temp=1.0, top_p=0.95."
  },
  "config": {
    "displayName": "DeepSeek V4 Flash",
    "family": "deepseek_v4",
    "maxOutputTokens": [131072, 65536, 32768, 16384],
    "capabilities": {
      "toolCalling": true,
      "imageInput": false
    },
    "defaultParams": {
      "temperature": 1.0,
      "top_p": 0.95
    },
    "modelModes": {
      "max": {
        "reasoning_effort": "max"
      },
      "high": {
        "reasoning_effort": "high"
      },
      // The card's "otherwise" recipe: top_p 1.0 overrides the agentic baseline.
      "none": {
        "reasoning_effort": "none",
        "top_p": 1.0
      }
    },
    "defaultMode": "high"
  }
}
