// Laguna-S-2.1 — Model configuration
// Source: Poolside model card + release blog post
// https://huggingface.co/poolside/Laguna-S-2.1
// https://poolside.ai/blog/introducing-laguna-s-2-1
// Verified 2026-11-10 against the current base/NVFP4 cards,
// generation_config.json and chat_template.jinja.
//
// NOTE: These params work for ANY quantization variant (NVFP4, FP8, INT4, GGUF, etc.).
// Preset matching is substring-based, so a preset for the base model applies to
// any served variant whose id contains it. The user model entry keeps
// its exact server model id; the preset does not rename it.
//
// Chat template parameters (all Jinja template variables, passed via chat_template_kwargs):
//   - `enable_thinking: true/false` — enables/disables native interleaved reasoning
//   - `preserve_thinking: true` — keeps <thinking>...</thinking> blocks visible in
//     multi-turn conversation history. Poolside recommends preserving reasoning
//     content for agentic coding workflows so the model can see prior reasoning steps.
//
// To apply manually, merge "config" into an existing model entry.
// Keep that entry's id, server and actual server model ID unchanged.
//
// Token budgets (262,144-token context):
//   - maxOutputTokens ladder [65536, 32768, 16384, 8192] — default 65,536
//     because thinking turns routinely run far past 32K (see below); still
//     leaves ~196K input, matching Poolside's advice to raise the cap for
//     long-horizon use.
//   - maxInputTokens: auto-computed as ~196,608 at the default pick
//   - Note: model supports up to 1M context and routinely generates 100K+ tokens
//     in thinking mode for agentic tasks.
//
// Sampling: the current NVFP4 card says generation_config.json is authoritative
// and recommends serving its defaults instead of overriding temperature/top_p:
//   https://huggingface.co/poolside/Laguna-S-2.1-NVFP4
// Both checkpoints ship temperature=1.0, top_p=1.0, min_p=0.0, top_k=20.
// Leave sampling unset here so the served checkpoint owns it.
//
// Thinking modes (per Poolside):
//   - Thinking on: model self-determines reasoning budget.
//   - "No-Think": direct responses, no reasoning tokens.
//   - There are NO intermediate effort levels (low/medium/high) — binary on/off only.
//   - Both "Think-General" and "Think-Code" remain available;
//     both use checkpoint sampling defaults and preserve reasoning history.
//
{
  "presetVersion": 1,
  "match": ["Laguna-S-2.1"],
  "meta": {
    "source": "https://huggingface.co/poolside/Laguna-S-2.1",
    "verified": "2026-11-10",
    "notes": "Poolside coding model with preserved thinking. Binary thinking (no effort levels); sampling is left to checkpoint defaults, as the current NVFP4 card recommends. Both General and Code thinking presets remain available."
  },
  "config": {
    "displayName": "Laguna-S-2.1",
    "family": "laguna",
    "maxOutputTokens": [65536, 32768, 16384, 8192],
    "capabilities": {
      "toolCalling": true,
      "imageInput": false
    },
    "modelModes": {
      "Think-General": {
        "chat_template_kwargs": {
          "enable_thinking": true,
          "preserve_thinking": true
        }
      },
      "Think-Code": {
        "chat_template_kwargs": {
          "enable_thinking": true,
          "preserve_thinking": true
        }
      },
      "No-Think": {
        "chat_template_kwargs": {
          "enable_thinking": false
        }
      }
    },
    // Harness "high" selects the default thinking mode, not a backend effort.
    "copilotHarnessMapping": {
      "high": "Think-General",
      "none": "No-Think"
    },
    "defaultMode": "Think-General"
  }
}
