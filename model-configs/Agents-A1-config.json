// Agents-A1 — Model configuration
// Source: InternScience model card, evaluation README inference parameters
// https://huggingface.co/InternScience/Agents-A1
// https://github.com/InternScience/Agents-A1/tree/main/evaluation
// Verified 2026-11-10 against the model/evaluation cards and official chat template.
//
// Chat template parameters (all Jinja template variables, passed via chat_template_kwargs):
//   - `enable_thinking: true/false` — enables/disables reasoning token generation
// The official template retains reasoning within the current tool-call turn,
// but drops it before the last real user query. It does not read preserve_thinking.
//
// To apply manually, merge "config" into an existing model entry.
// Keep that entry's id, server and actual server model ID unchanged.
//
// Token budgets:
//   - Context window: 262,144 tokens (recommended by authors)
//   - maxOutputTokens ladder [32768, 16384, 8192] — default 32,768
//     (conservative; model supports more), 8,192 for quick answers
//   - maxInputTokens: auto-computed as ~229,376 (context window minus output)
//
// Modes (inference params sourced from authors' evaluation README files per domain):
//   - Think-General:  Official model card defaults
//   - Think-Coding:   evaluation/MLE/README.md (SciCode, MLE-Lite)
//   - Think-Science:  evaluation/Science/README.md (HiPhO, FS-O, FS-R)
//   - none:         Direct responses, no thinking tokens

{
  "presetVersion": 1,
  "match": ["Agents-A1"],
  "meta": {
    "source": "https://huggingface.co/InternScience/Agents-A1",
    "verified": "2026-11-10",
    "notes": "Scientific agent MoE with binary thinking via enable_thinking. The official template retains reasoning only within the current turn; per-domain modes use the authors' evaluation sampling."
  },
  "config": {
    "displayName": "Agents-A1",
    "family": "qwen3_5_moe",
    "maxOutputTokens": [32768, 16384, 8192],
    "capabilities": {
      "toolCalling": true,
      "imageInput": true
    },
    "defaultParams": {
      "top_p": 0.95
    },
    "modelModes": {
      "Think-General": {
        "chat_template_kwargs": {
          "enable_thinking": true
        },
        "temperature": 0.85,
        "top_k": 20,
        "min_p": 0.0,
        "presence_penalty": 1.1,
        "repetition_penalty": 1.0
      },
      "Think-Coding": {
        "chat_template_kwargs": {
          "enable_thinking": true
        },
        "temperature": 1.0,
        "top_k": 20,
        "min_p": 0.0,
        "presence_penalty": 1.5,
        "repetition_penalty": 1.0
      },
      "Think-Science": {
        "chat_template_kwargs": {
          "enable_thinking": true
        },
        "temperature": 0.6
      },
      "none": {
        "chat_template_kwargs": {
          "enable_thinking": false
        },
        "temperature": 0.85,
        "top_k": 20,
        "min_p": 0.0,
        "presence_penalty": 1.1,
        "repetition_penalty": 1.0
      }
    },
    // Harness "high" selects the default thinking mode, not a backend effort.
    "copilotHarnessMapping": {
      "high": "Think-General"
    },
    "defaultMode": "Think-General"
  }
}