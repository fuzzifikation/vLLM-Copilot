// GLM-5.3 (Z.ai, full model) — Model configuration
// Source: https://huggingface.co/zai-org/GLM-5.3 + vLLM recipe
// (recipes.vllm.ai/zai-org/GLM-5.3). Verified 2026-08-30.
//
// NOT the same model as GLM-5.3-Flash — different base architecture:
// the full model reuses the GLM-5.2 base (model_type "glm_moe_dsa",
// 743B total / 39B active MoE); the card says every gain comes from
// post-training. Flash is the separate "glm5_next" architecture and has
// its own preset (GLM-5.3-Flash.json). Longest-match routing keeps them
// apart: served ids containing "GLM-5.3-Flash" win the Flash preset,
// everything else ("GLM-5.3", "GLM-5.3-FP8", ...) lands here.
//
// TEXT-ONLY: unlike Flash (natively multimodal), the full GLM-5.3 has no
// image/video input — do not add imageInput without card evidence.
// 1,048,576-token native context — NO YaRN-style extension needed.
// Default checkpoint is FP8 (server-side detail, irrelevant here).
//
// NOTE: These params work for ANY quantization variant. Preset matching is
// substring-based, so this preset also matches "GLM-5.3-FP8". The
// config's `vllmModelId` must still be an EXACT served model id.
//
// ⚠️ THINKING IS ALWAYS ON — the chat template opens a  block
// unconditionally. There is NO "No Think" mode for this model (unlike
// GLM-5.2, which has enable_thinking:false). Reasoning depth is controlled
// ONLY through `reasoning_effort`.
//
// Reasoning effort (vLLM recipe + card — identical semantics to Flash):
//   - low | high | max. Template resolves to "max" unless reasoning_effort is
//     explicitly "low" or "high" — any other value falls back to "max".
//   - Card: keep the default "max" for benchmark/leaderboard reproduction.
//   - `clear_thinking` (chat_template_kwargs): defaults to false; the card
//     says to pass clear_thinking=true for chat scenarios (strips historical
//     thinking blocks from earlier turns).
//
// Sampling: benchmark footnotes use temp=1.0 with top_p between 0.95 and
// 1.0. temp=1.0/top_p=0.95 matches the GLM-5.2 preset.
//
// Token budgets (1,048,576 native context):
//   - Card agent benchmarks generate up to 128,000–163,840 tokens, so the
//     ladder tops at 131,072 — at full 1M server context that still leaves
//     ~917K input. On smaller serve windows (e.g. 262K) pick 65536 or lower
//     in the Output Length dropdown to keep input headroom.
//   - input = context − max_tokens, so output budgets here never starve input.
//
// To use manually, copy the "config" object below into settings.json:
//   "vllm-copilot.models": [ <PASTE_HERE> ]


{
  "presetVersion": 1,
  "match": ["GLM-5.3"],
  "meta": {
    "name": "GLM-5.3",
    "source": "https://huggingface.co/zai-org/GLM-5.3",
    "verified": "2026-08-30",
    "notes": "Full GLM-5.3 (glm_moe_dsa, same base as GLM-5.2, text-only). Thinking always on - depth only via reasoning_effort (max/high/low); clear_thinking strips historical thinking. temp=1.0, top_p=0.95. Flash has its own preset."
  },
  "config": {
    "vllmModelId": "GLM-5.3",
    "displayName": "GLM-5.3",
    "family": "glm_moe_dsa",
    "maxOutputTokens": [131072, 65536, 32768, 16384],
    "capabilities": {
      "toolCalling": true
    },
    "modelModes": {
      "Think (Max)": {
        "reasoning_effort": "max",
        "chat_template_kwargs": {
          "clear_thinking": true
        },
        "temperature": 1.0,
        "top_p": 0.95,
        "presence_penalty": 0
      },
      "Think (High)": {
        "reasoning_effort": "high",
        "chat_template_kwargs": {
          "clear_thinking": true
        },
        "temperature": 1.0,
        "top_p": 0.95,
        "presence_penalty": 0
      },
      "Think (Low)": {
        "reasoning_effort": "low",
        "chat_template_kwargs": {
          "clear_thinking": true
        },
        "temperature": 1.0,
        "top_p": 0.95,
        "presence_penalty": 0
      }
    },
    "defaultMode": "Think (Max)"
  }
}
