// GLM-5.2 (Z-AI) — Model configuration
// Sourced from vLLM recipe (recipes.vllm.ai/zai-org/GLM-5.2),
// Z.ai docs (docs.z.ai/guides/capabilities/thinking-mode), and GitHub (github.com/zai-org/GLM-5).
// Verified 2026-07-10 against official sources.
//
// NOTE: These params work for ANY quantization variant (FP8, GGUF, AWQ, etc.).
// Preset matching is substring-based, so a preset for the base model applies to
// any served variant whose id contains it. The user model entry keeps
// its exact server model id; the preset does not rename it.
//
// Reasoning modes (from vLLM recipe):
//   - max:  omit reasoning_effort or set "max" — deepest reasoning
//   - high: "reasoning_effort": "high" — balanced depth/latency
//   - none: chat_template_kwargs.enable_thinking: false — no chain-of-thought
//   Template resolves to "max" unless reasoning_effort is explicitly "high".
//
// Generation defaults: temperature=1.0, top_p=0.95 (from model card benchmarks).
//
// Token budgets:
//   - Context window: 1,048,576 tokens (same base architecture as GLM-5.3).
//   - maxOutputTokens ladder [131072, 65536, 32768, 16384] — default 131,072
//     leaves ~917K input at full 1M server context; on smaller serve windows
//     pick a shorter length in the Output Length dropdown.
//
// To apply manually, merge "config" into an existing model entry.
// Keep that entry's id, server and actual server model ID unchanged.

{
  "presetVersion": 1,
  "match": ["GLM-5.2"],
  "meta": {
    "source": "https://recipes.vllm.ai/zai-org/GLM-5.2",
    "verified": "2026-07-10",
    "notes": "Thinking depth via reasoning_effort (max/high); enable_thinking=false disables chain-of-thought. Sampling temp=1.0, top_p=0.95."
  },
  "config": {
    "displayName": "GLM-5.2",
    "family": "glm_moe_dsa",
    "maxOutputTokens": [131072, 65536, 32768, 16384],
    "capabilities": {
      "toolCalling": true,
      "imageInput": false
    },
    "defaultParams": {
      "temperature": 1.0,
      "top_p": 0.95,
      "presence_penalty": 0
    },
    "modelModes": {
      "max": {
        "reasoning_effort": "max"
      },
      "high": {
        "reasoning_effort": "high"
      },
      "none": {
        "chat_template_kwargs": {
          "enable_thinking": false
        }
      }
    },
    "defaultMode": "high"
  }
}
