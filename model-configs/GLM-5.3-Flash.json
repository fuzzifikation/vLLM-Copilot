// GLM-5.3-Flash (Z.ai) — Model configuration
// Source: https://huggingface.co/zai-org/GLM-5.3-Flash + vLLM recipe
// (recipes.vllm.ai/zai-org/GLM-5.3-Flash). Verified 2026-08-27.
//
// Keyed "GLM-5.3-Flash" (longer than "GLM-5.3"): the longest-match rule
// routes every served id containing "GLM-5.3-Flash" here, while the full
// GLM-5.3 (a different architecture — glm_moe_dsa, text-only) gets
// GLM-5.3.json. Do not merge them again.
//
// NEW ARCHITECTURE: model_type "glm5_next" (NOT glm_moe_dsa like GLM-5.2).
// 320B total / 18B active MoE, first natively multimodal model in the
// GLM-5 series (image + video input), hybrid KDA linear attention + sparse MLA.
// 1,048,576-token native context — NO YaRN-style extension needed.
//
// NOTE: These params work for ANY quantization variant. Preset matching is
// substring-based, so this preset also matches "GLM-5.3-Flash-BF16". The
// config's `vllmModelId` must still be an EXACT served model id.
//
// ⚠️ THINKING IS ALWAYS ON — the chat template opens a  block
// unconditionally. There is NO "No Think" mode for this model (unlike
// GLM-5.2, which has enable_thinking:false). Reasoning depth is controlled
// ONLY through `reasoning_effort`.
//
// Reasoning effort (vLLM recipe + card):
//   - low | high | max. Template resolves to "max" unless reasoning_effort is
//     explicitly "low" or "high" — any other value falls back to "max".
//   - Card: keep the default "max" for benchmark/leaderboard reproduction.
//   - `clear_thinking` (chat_template_kwargs): defaults to false; the card
//     says to pass clear_thinking=true for chat scenarios (strips historical
//     thinking blocks from earlier turns).
//
// Sampling: no single official recipe; benchmark footnotes use temp=1.0 with
// top_p between 0.95 and 1.0. temp=1.0/top_p=0.95 matches the GLM-5.2 preset.
//
// Token budgets (1,048,576 native context):
//   - Card benchmarks generate up to 163,840 (HLE) / 65,536 (Terminal-Bench)
//     tokens, so the ladder tops at 131,072 — at full 1M context that still
//     leaves ~917K input. On smaller serve windows pick a shorter length in
//     the Output length dropdown.
//   - input = context − max_tokens, so output budgets here never starve input.
//
// To use manually, copy the "config" object below into settings.json:
//   "vllm-copilot.models": [ <PASTE_HERE> ]


{
  "presetVersion": 1,
  "match": ["GLM-5.3-Flash"],
  "meta": {
    "name": "GLM-5.3-Flash",
    "source": "https://huggingface.co/zai-org/GLM-5.3-Flash",
    "verified": "2026-08-27",
    "notes": "glm5_next family, natively multimodal (image + video). Thinking always on — depth only via reasoning_effort (max/high/low); clear_thinking strips historical thinking. temp=1.0, top_p=0.95."
  },
  "config": {
    "vllmModelId": "GLM-5.3-Flash",
    "displayName": "GLM-5.3-Flash",
    "family": "glm5_next",
    "maxOutputTokens": [131072, 65536, 32768, 16384],
    "capabilities": {
      "toolCalling": true,
      "imageInput": true
    },
    "modelModes": {
      "Think (Max)": {
        "reasoning_effort": "max",
        "chat_template_kwargs": {
          "clear_thinking": true
        },
        "temperature": 1.0,
        "top_p": 0.95,
        "presence_penalty": 0
      },
      "Think (High)": {
        "reasoning_effort": "high",
        "chat_template_kwargs": {
          "clear_thinking": true
        },
        "temperature": 1.0,
        "top_p": 0.95,
        "presence_penalty": 0
      },
      "Think (Low)": {
        "reasoning_effort": "low",
        "chat_template_kwargs": {
          "clear_thinking": true
        },
        "temperature": 1.0,
        "top_p": 0.95,
        "presence_penalty": 0
      }
    },
    "defaultMode": "Think (Max)"
  }
}
